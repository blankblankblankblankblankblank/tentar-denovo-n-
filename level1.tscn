[sub_resource type="Shader" id="Shader_xtnnu"]
code = "shader_type spatial;
uniform sampler2D text;
uniform sampler2D noise1;
uniform sampler2D noise2;
varying vec4 text_a;

void fragment(){
	text_a = texture(noise1,UV*abs(sin(TIME)+20.0));
	ALBEDO = texture(text,UV/(TIME*4.0)).rgb * vec3(0.1,0.4,1.0);
	text_a = mix(text_a,ALBEDO.brbr,texture(noise2,UV).b);
	text_a = mix(text_a,ALBEDO.grbr,texture(noise1,UV).r);
	ALBEDO = text_a.rgb * vec3(0.1,0.8,1.0);
	ALPHA = 0.32;
}

void vertex() {
	//VERTEX.y += max(abs(sin(texture(text,UV*sin(TIME * 0.00001)).r*TIME*4.0)*0.6),0.2);
	VERTEX.y += max(abs(sin(texture(text,UV).r*TIME*4.0))+0.5,0);
}
"

